{
  "name": "binderbooks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BinderBooks — a Pokémon card buying/selling/ripping P&L ledger",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:ios": "vite build --mode ios --outDir ios/www --emptyOutDir",
    "ios:icon": "node scripts/gen-icons.mjs",
    "ios:project": "cd ios && xcodegen generate",
    "ios": "npm run build:ios && npm run ios:project",
    "ios:device": "node scripts/ios-device.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "lucide-react": "^0.383.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.10"
  }
}
